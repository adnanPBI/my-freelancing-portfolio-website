# Copy settings into your process manager's ENVIRONMENT, not into frontend code.
HOST=127.0.0.1
PORT=3000
# Use a persistent server-side volume. Do not store private inquiries in a public folder.
DATA_DIR=/var/lib/adnan-portfolio
# REQUIRED for admin inbox, minimum 16 characters. Generate a long random value.
ADMIN_TOKEN=replace_with_a_32_plus_character_random_secret
